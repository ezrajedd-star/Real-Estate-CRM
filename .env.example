# Local development only. Copy to .env and replace every CHANGE_ME with a random value
# (e.g. `openssl rand -base64 32`). Never commit .env; production secrets live in AWS
# Secrets Manager.

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=CHANGE_ME
APP_MIGRATOR_PASSWORD=CHANGE_ME
APP_RW_PASSWORD=CHANGE_ME
APP_WORKER_PASSWORD=CHANGE_ME
DATABASE_URL_MIGRATOR=postgres://app_migrator:CHANGE_ME@localhost:5432/leasing
DATABASE_URL_APP=postgres://app_rw:CHANGE_ME@localhost:5432/leasing
DATABASE_URL_WORKER=postgres://app_worker:CHANGE_ME@localhost:5432/leasing

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# --- Keycloak (OIDC) ---
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
OIDC_ISSUER=http://localhost:8080/realms/pmo
OIDC_CLIENT_ID=leasing-staff
OIDC_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_ID=leasing-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# Google Workspace SSO (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# --- Web / API ---
PUBLIC_WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
API_INTERNAL_URL=http://localhost:4000
# Secure cookies work on http://localhost in Chromium/Firefox; keep true.
COOKIE_SECURE=true
IP_HASH_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# 32 random bytes, base64. Dev/test only — production uses KMS_KEY_ID.
LOCAL_KEK_BASE64=CHANGE_ME
UPLOAD_ORIGIN=http://localhost:9000

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=leasing-dev
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=leasing-documents
S3_AUDIT_BUCKET=leasing-audit

# --- Worker ---
CLAMD_HOST=localhost
CLAMD_PORT=3310
