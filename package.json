{
  "name": "leasing-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.yml down",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:seed": "pnpm --filter @crm/seed seed",
    "db:reset:local": "bash infra/scripts/db-reset-local.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "lefthook": "1.13.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "lefthook"
    ]
  }
}
