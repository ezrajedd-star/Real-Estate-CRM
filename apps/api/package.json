{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests test/unit",
    "test:integration": "vitest run test/integration",
    "openapi": "tsx src/openapi/write.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@crm/contracts": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/domain": "workspace:*",
    "@crm/platform": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "s3rver": "3.7.1",
    "unplugin-swc": "1.6.0"
  }
}
