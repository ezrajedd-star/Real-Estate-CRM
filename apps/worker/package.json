    "@crm/domain": "workspace:*",
    "@crm/platform": "workspace:*",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.3",
    "file-type": "19.6.0",
    "ioredis": "5.11.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "s3rver": "3.7.1"
  }
}
